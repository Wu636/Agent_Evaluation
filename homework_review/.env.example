# 智慧树平台认证信息
# 登录后从浏览器开发者工具获取
AUTHORIZATION=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...
COOKIE=hike-polymas-identity=1; themeVariables=...

# 任务配置
INSTANCE_NID=XLRNIzbkox
TASK_ID=LRdRYm0MzKh4y0ORExjw

# LLM API 配置（用于答案校验）
LLM_API_KEY=your_api_key_here
LLM_API_URL=http://llm-service.polymas.com/api/openai/v1/chat/completions
# 可选：gpt-5.4 / claude-opus-4-6
LLM_MODEL=gpt-5.4

# AgentEval 用户登录校验（必须与前端使用同一个 Supabase 项目）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# 旧版 HS256 项目可选；留空时使用 Supabase Auth API 校验
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
REVIEW_AUTH_CACHE_SECONDS=60

# 单 Railway 实例：用户隔离与公平并发
MAX_ACTIVE_REVIEW_JOBS_PER_USER=1
MAX_ACTIVE_TRADITIONAL_REVIEW_JOBS=1
MAX_GLOBAL_SKILL_ATTEMPTS=10
MAX_SKILL_ATTEMPTS_PER_USER=3
MAX_GLOBAL_SKILL_UPLOADS=4
MAX_SKILL_UPLOADS_PER_USER=2
